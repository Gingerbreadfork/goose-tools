# goose-tools configuration. Copy to <repo>/.env and edit. Every tool reads only what it needs.

# --- Model server (any OpenAI-compatible API: Halogen, llama.cpp, vLLM, Ollama, LM Studio, OpenAI itself) ---
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=change-me
CHAT_MODEL=your-chat-model                 # watchers summaries / voice agent brain
VISION_MODEL=your-vision-model             # vision tool (a model that accepts image input)
IMAGE_MODEL=your-image-model               # imagegen tool (/images/generations)
ASR_MODEL=whisper-1                        # media + voice (/audio/transcriptions, WAV upload)
TTS_MODEL=tts-1                            # voice agent (/audio/speech, pcm)
# Optional Jev / System One compatible decision endpoint (fast calibrated yes/no, choice, score). Halogen: <base>/systemone
#SYSTEMONE_URL=http://127.0.0.1:8080/v1/systemone
#SYSTEMONE_MODEL=d3-nano

# --- Files the tools produce ---
GOOSE_WORK=~/goose-work                    # images/, reports/, media/, transcripts/, docs-cache/ live here
# Optional HTTPS gallery serving GOOSE_WORK/images so chat clients can render images (see scripts/start-gallery.sh)
#GALLERY_URL=https://192.168.1.10:8443/images

# --- Notifications (reminders, watchers; NOTIFY_BACKEND = signal | ntfy | command | stdout) ---
NOTIFY_BACKEND=stdout
# Signal via signal-cli-rest-api (scripts/start-signal.sh). Link to your own account (Note to Self) or a separate number.
#SIGNAL_API=http://127.0.0.1:8090
#SIGNAL_BOT_NUMBER=+61400000000
#SIGNAL_USER_NUMBER=+61400000000
# ntfy
#NTFY_URL=https://ntfy.sh
#NTFY_TOPIC=your-random-topic
# Anything else: a command that reads the message on stdin
#NOTIFY_COMMAND=/usr/local/bin/post-to-telegram.sh

# --- Places & travel (OpenStreetMap services; set a home so "near me" works) ---
#PLACES_HOME_NAME=Horsham, Victoria
#PLACES_HOME_LAT=-36.71
#PLACES_HOME_LON=142.20
#PLACES_COUNTRY=au
#PLACES_USER_AGENT=my-goose-tools/1.0 (contact@example.com)   # OSM asks clients to identify themselves
#FORCE_IPV4=1                               # if your host has a broken IPv6 route

# --- Services the tools talk to ---
DOCLING_URL=http://127.0.0.1:5001          # scripts/start-docling.sh
LAB_URL=http://127.0.0.1:8800              # scripts/start-lab.sh
PLAYWRIGHT_URL=http://127.0.0.1:8931/mcp   # scripts/start-browser.sh (watchers with use_browser)
MEDIA_CONTAINER=goose-lab                  # where yt-dlp/ffmpeg run when not installed locally

# --- Remote files (attachments from the computer running Goose Desktop) ---
#REMOTE_FILES_TOKEN=generate-a-long-random-string
#GOOSE_SERVER_PORT=3000                     # the goose serve port; the connected client is discovered from it
#REMOTE_FILES_EXTRA_HOSTS=                  # comma-separated fixed machines, optional

# --- Signal bridge (chat with Goose from your phone) ---
#GOOSE_BIN=~/.local/bin/goose
#BRIDGE_WORKDIR=~
#GOOSE_SESSIONS_DB=~/.local/share/goose/sessions/sessions.db
